+    async def _download_message_media(
+        self, message: dict[str, Any]
+    ) -> tuple[list[str], list[str]]:
+        """Download the largest incoming photo or document and attach its real path."""
+        attachment: dict[str, Any] | None = None
+        media_type = "file"
+        photos = message.get("photo")
+        if isinstance(photos, list):
+            candidates = [item for item in photos if isinstance(item, dict) and item.get("file_id")]
+            if candidates:
+                attachment = max(
+                    candidates,
+                    key=lambda item: (
+                        int(item.get("file_size") or 0),
+                        int(item.get("width") or 0) * int(item.get("height") or 0),
+                    ),
+                )
+                media_type = "image"
+        if attachment is None and isinstance(message.get("document"), dict):
+            document = message["document"]
+            if document.get("file_id"):
+                attachment = document
+
+        if attachment is None:
+            return [], []
+
+        try:
+            file_info = await self._api("getFile", {"file_id": attachment["file_id"]})
+            remote_path = str(file_info.get("file_path") or "").lstrip("/")
+            if not remote_path:
+                raise RuntimeError("getFile returned no file_path")
+            if self._client is None:
+                raise RuntimeError("Imgram HTTP client is not initialized")
+            response = await self._client.get(f"/file/bot{self.config.token}/{remote_path}")
+            response.raise_for_status()
+            if len(response.content) > IMGRAM_MAX_UPLOAD_BYTES:
+                raise RuntimeError("incoming Imgram file exceeds 50 MiB")
+
+            original_name = str(attachment.get("file_name") or Path(remote_path).name)
+            suffix = Path(original_name).suffix or (".jpg" if media_type == "image" else "")
+            unique_id = str(attachment.get("file_unique_id") or attachment["file_id"])
+            safe_id = re.sub(r"[^A-Za-z0-9_-]", "_", unique_id)[:160] or "attachment"
+            destination = get_media_dir("imgram") / f"{safe_id}{suffix[:16]}"
+            destination.write_bytes(response.content)
+            path = str(destination)
+            return [path], [f"[{media_type}: {path}]"]
+        except Exception as exc:
+            self.logger.warning("failed to download incoming {}: {}", media_type, exc)
+            return [], [f"[{media_type}: download failed]"]
+
